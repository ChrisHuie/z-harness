# Allowlist, not blocklist.
#
# ~/.claude is ~750 KB of authored harness inside ~1.6 GB of machine state. A blocklist
# means the next vendor directory gets committed by accident; an allowlist means new
# junk is invisible by default and has to be opted in.
#
# WARNING: `git clean -fdx` here would delete ignored files — that is 1.5 GB of
# transcripts under projects/, the corpus every measurement in harness-audit-* came
# from. Plain `git clean -fd` is safe; ignored files survive it. Never use -x here.

# 1. ignore everything
*

# 2. un-ignore the authored surface (dirs must be re-included before their contents)
!.gitignore
!CLAUDE.md
!settings.json
!statusline.sh
!.github/
!.github/**
!tools/
!tools/**

!skills/
!skills/**
!hooks/
!hooks/**
!agents/
!agents/**
!commands/
!commands/**

# 3. the harness record — docs only, not the 51 MB of backups and agent transcripts
!harness-audit-20260801/
!harness-audit-20260801/*.md
!harness-audit-20260801/*.tgz
!harness-audit-20260801/scripts/
!harness-audit-20260801/scripts/**
!harness-audit-20260801/routing/
!harness-audit-20260801/routing/**
!harness-audit-20260801/baselines/
!harness-audit-20260801/baselines/**
!harness-audit-20260801/retired-skill-references/
!harness-audit-20260801/retired-skill-references/**

# 4. never, regardless of the above
.credentials.json
*.credentials.json
**/node_modules/
**/__pycache__/
*.pyc
.DS_Store

# guard runtime logs — churn on every selftest, not authored content
hooks/*events*.jsonl

# 5. the authored memory layer — index + distilled facts, never transcripts.
# projects/*/ stays ignored except each project's memory/ subtree.
!projects/
!projects/*/
!projects/*/memory/
!projects/*/memory/**

# --- added after the first push: evidence and pre-git state ---
# git's first commit is the END state of the 2026-08-01/02 rebuild. The PRE* snapshots
# are the ONLY record of what the harness looked like before it, and git history cannot
# reconstruct them. reports/ and drafts/ are the findings and the derivation behind every
# conclusion in the .md records. experiments/ (43 MB of raw run data) stays out.
!harness-audit-20260801/reports/
!harness-audit-20260801/reports/**
!harness-audit-20260801/drafts/
!harness-audit-20260801/drafts/**
!harness-audit-20260801/misfiled-memories/
!harness-audit-20260801/misfiled-memories/**
!harness-audit-20260801/PRE-MIGRATION-BACKUP/
!harness-audit-20260801/PRE-MIGRATION-BACKUP/**
# PREINSTALL-20260802-085154/ tree tarred 2026-08-02 (reserved-basename collision, row 25);
# bytes preserved in PREINSTALL-20260802-085154.tgz via the *.tgz line above
!harness-audit-20260801/PREMEM-20260802-154631/
!harness-audit-20260801/PREMEM-20260802-154631/**
!harness-audit-20260801/PREHOOKS-20260802-154226/
!harness-audit-20260801/PREHOOKS-20260802-154226/**
