{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChrisHuie/z-harness/blob/v0.4.0-alpha.3/contracts/artifact-manifest.schema.json",
  "title": "z-harness rendered artifact manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "artifactId",
    "packageName",
    "coreVersion",
    "packageVersion",
    "licenses",
    "target",
    "format",
    "adapterRevision",
    "build",
    "source",
    "payload"
  ],
  "properties": {
    "$schema": {
      "const": "https://github.com/ChrisHuie/z-harness/blob/v0.4.0-alpha.3/contracts/artifact-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 4
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "packageName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "coreVersion": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "adapterRevision": {
      "type": "integer",
      "minimum": 1
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer",
        "rendererVersion",
        "digestAlgorithm",
        "filesystemProfile",
        "rendererSha256",
        "contractsSha256",
        "renderConfigSha256",
        "adapterConfigSha256"
      ],
      "properties": {
        "renderer": {
          "const": "z-harness/render-packages"
        },
        "rendererVersion": {
          "type": "string",
          "minLength": 1
        },
        "digestAlgorithm": {
          "const": "z-harness-framed-sha256-v2"
        },
        "filesystemProfile": {
          "const": "z-harness-posix-tree-v1"
        },
        "rendererSha256": {
          "$ref": "#/$defs/sha256"
        },
        "contractsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "renderConfigSha256": {
          "$ref": "#/$defs/sha256"
        },
        "adapterConfigSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "inputTreeSha256",
        "includedTreeSha256",
        "upstreamLocks",
        "skills"
      ],
      "properties": {
        "kind": {
          "const": "canonical-tree"
        },
        "inputTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "includedTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "upstreamLocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision",
              "sha256",
              "licenses"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "licenses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "inputTreeSha256",
              "includedTreeSha256",
              "includedFiles",
              "excludedPaths"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "inputTreeSha256": {
                "$ref": "#/$defs/sha256"
              },
              "includedTreeSha256": {
                "$ref": "#/$defs/sha256"
              },
              "includedFiles": {
                "type": "integer",
                "minimum": 1
              },
              "excludedPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "files"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "0644",
            "0755"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
